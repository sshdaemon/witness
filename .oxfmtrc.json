{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "avoid",
  "quoteProps": "as-needed",
  "useTabs": false,
  "endOfLine": "lf",
  "ignorePatterns": [
    "results/**",
    "dist/**",
    ".profiles/**",
    ".sessions/**",
    "package-lock.json",
    "pnpm-lock.yaml"
  ]
}
